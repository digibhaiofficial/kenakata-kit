msgstr "আপনার প্রশ্ন"

msgid "e.g. Is this suitable for oily skin?"
msgstr "যেমন: এটা কি তৈলাক্ত ত্বকের জন্য উপযুক্ত?"

msgid "Phone number"
msgstr "ফোন নম্বর"

msgid "Not shown on the site. We may call you about your question."
msgstr "সাইটে দেখানো হবে না। প্রশ্নের বিষয়ে আমরা আপনাকে কল করতে পারি।"

msgid "Send question"
msgstr "প্রশ্ন পাঠান"

msgid "Questions are switched off."
msgstr "প্রশ্নোত্তর বন্ধ আছে।"

msgid "Product not found."
msgstr "প্রোডাক্ট পাওয়া যায়নি।"

msgid "Please enter your name."
msgstr "আপনার নাম লিখুন।"

msgid "Please write your question."
msgstr "আপনার প্রশ্ন লিখুন।"

msgid "Please enter a valid 11-digit mobile number."
msgstr "সঠিক ১১ সংখ্যার মোবাইল নম্বর দিন।"

msgid "Please wait a minute before sending another question."
msgstr "আরেকটি প্রশ্ন পাঠানোর আগে এক মিনিট অপেক্ষা করুন।"

msgid "You have sent several questions today. Please call or WhatsApp us instead."
msgstr "আজ আপনি কয়েকটি প্রশ্ন পাঠিয়েছেন। দয়া করে কল বা WhatsApp করুন।"

msgid "New product question: %s"
msgstr "নতুন প্রোডাক্ট প্রশ্ন: %s"

msgid "Answer it here"
msgstr "এখানে উত্তর দিন"

msgid "Thank you! Your question was sent. We will answer it soon."
msgstr "ধন্যবাদ! আপনার প্রশ্ন পাঠানো হয়েছে। শিগগিরই উত্তর দেব।"

msgid "Product questions"
msgstr "প্রোডাক্টের প্রশ্ন"

msgid "Not allowed."
msgstr "অনুমতি নেই।"

msgid "Question not found."
msgstr "প্রশ্ন পাওয়া যায়নি।"

