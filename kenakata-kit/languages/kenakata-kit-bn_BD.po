msgid "The theme / plugin file editor is on: a stolen password could change your site's code"
msgstr "থিম / প্লাগইন ফাইল এডিটর চালু: পাসওয়ার্ড চুরি হলে কেউ সাইটের কোড বদলে দিতে পারে"

msgid "XML-RPC (old remote login, a common attack door) is off"
msgstr "XML-RPC (পুরোনো রিমোট লগইন, হামলার একটা সাধারণ দরজা) বন্ধ আছে"

msgid "XML-RPC is on: turn it off unless you use the old WordPress app or Jetpack"
msgstr "XML-RPC চালু: পুরোনো WordPress অ্যাপ বা Jetpack ব্যবহার না করলে বন্ধ করুন"

msgid "Cloudflare Turnstile protects the login"
msgstr "লগইন Cloudflare Turnstile দিয়ে সুরক্ষিত"

msgid "Login has no bot check: turn on Cloudflare Turnstile on this page (free)"
msgstr "লগইনে বট যাচাই নেই: এই পেজেই Cloudflare Turnstile চালু করুন (ফ্রি)"

msgid "%d administrators: give staff the \"Store Manager\" or \"Shop manager\" role instead"
msgstr "%d জন অ্যাডমিন: স্টাফদের বরং \"Store Manager\" বা \"Shop manager\" রোল দিন"

msgid "All plugins are up to date"
msgstr "সব প্লাগইন আপডেট করা আছে"

msgid "Site checkup"
msgstr "সাইট চেকআপ"

msgid "Security checkup"
msgstr "নিরাপত্তা চেকআপ"

msgid "Database clean-up"
msgstr "ডাটাবেস পরিষ্কার"

msgid "Removes only leftovers that WordPress no longer needs. Products, orders, pages, posts and revisions are never touched."
msgstr "শুধু WordPress-এর আর দরকার নেই এমন বাড়তি জিনিস মোছে। প্রোডাক্ট, অর্ডার, পেজ, পোস্ট ও রিভিশনে কখনো হাত দেয় না।"

msgid "Expired temporary data: %d"
msgstr "মেয়াদ শেষ অস্থায়ী ডাটা: %d"

msgid "Expired cart sessions: %d"
msgstr "মেয়াদ শেষ কার্ট সেশন: %d"

msgid "Spam comments older than 30 days: %d"
msgstr "৩০ দিনের পুরোনো স্প্যাম কমেন্ট: %d"

msgid "Clean up now"
msgstr "এখনই পরিষ্কার করুন"

msgid "Speed & health"
msgstr "স্পিড ও হেলথ"

msgid "Make the site lighter, stop login bots, and see a checkup of speed and security with what to fix. Every switch is off until you turn it on."
msgstr "সাইট হালকা করুন, লগইন বট থামান, আর স্পিড ও নিরাপত্তার চেকআপে দেখুন কী ঠিক করতে হবে। আপনি চালু না করা পর্যন্ত সব সুইচ বন্ধ থাকে।"

msgid "Also ask for the order number"
msgstr "অর্ডার নম্বরও চাইবে"

msgid "More private: someone who only knows a phone number cannot see that person's orders. The customer finds the order number on the thank-you page and in the order SMS/email."
msgstr "বেশি গোপনীয়: শুধু ফোন নম্বর জানলেই কেউ ওই ব্যক্তির অর্ডার দেখতে পারবে না। কাস্টমার অর্ডার নম্বর পাবেন থ্যাংক-ইউ পেজে এবং অর্ডারের SMS/ইমেইলে।"

msgid "Couriers I use"
msgstr "আমি যেসব কুরিয়ার ব্যবহার করি"

msgid "Tick the couriers you send parcels with: only these appear in the order's courier list. When you type a tracking ID, the tracking link is made automatically (where the courier has a tracking page). You can paste your own link with {id} where the tracking ID goes."
msgstr "যেসব কুরিয়ারে পার্সেল পাঠান সেগুলোতে টিক দিন: অর্ডারের কুরিয়ার তালিকায় শুধু এগুলোই আসবে। ট্র্যাকিং আইডি লিখলে ট্র্যাকিং লিংক নিজে থেকে তৈরি হবে (যে কুরিয়ারের ট্র্যাকিং পেজ আছে)। চাইলে নিজের লিংক দিতে পারেন, ট্র্যাকিং আইডির জায়গায় {id} লিখে।"

msgid "Other couriers"
msgstr "অন্যান্য কুরিয়ার"

msgid "Not in the list above? One per line: key|Name|tracking link (the link is optional; put {id} where the tracking ID goes). Example: fastx|FastX Courier|https://fastx.example/track/{id}"
msgstr "উপরের তালিকায় নেই? প্রতি লাইনে একটি: key|নাম|ট্র্যাকিং লিংক (লিংক না দিলেও চলে; ট্র্যাকিং আইডির জায়গায় {id} লিখুন)। উদাহরণ: fastx|FastX Courier|https://fastx.example/track/{id}"

msgid "RedX"
msgstr "RedX"

msgid "Send orders to RedX with one tap. New: please send your first parcel while watching your RedX panel."
msgstr "এক ট্যাপে RedX-এ অর্ডার পাঠান। নতুন ফিচার: প্রথম পার্সেলটা RedX প্যানেল খোলা রেখে পাঠিয়ে মিলিয়ে নিন।"

msgid "API access token"
msgstr "API অ্যাক্সেস টোকেন"

msgid "From RedX (redx.com.bd → Developer API, or ask your RedX contact). Kept private. Leave empty to keep the saved token."
msgstr "RedX থেকে নিন (redx.com.bd → Developer API, অথবা আপনার RedX প্রতিনিধিকে বলুন)। গোপন রাখা হয়। সেভ করা টোকেন রাখতে ফাঁকা রাখুন।"

msgid "Pickup store ID (optional)"
msgstr "পিকআপ স্টোর আইডি (ঐচ্ছিক)"

msgid "Empty = your default RedX pickup store. \"Test connection\" lists your stores with their numbers."
msgstr "ফাঁকা = আপনার ডিফল্ট RedX পিকআপ স্টোর। \"Test connection\" চাপলে স্টোরগুলোর নম্বরসহ তালিকা দেখাবে।"

msgid "Default delivery area ID (optional)"
msgstr "ডিফল্ট ডেলিভারি এরিয়া আইডি (ঐচ্ছিক)"

msgid "RedX needs an area for every parcel. It is found from the address; when no area name is in the address, this one is used."
msgstr "RedX প্রতিটি পার্সেলের জন্য এরিয়া চায়। ঠিকানা থেকে এরিয়া খুঁজে নেওয়া হয়; ঠিকানায় এরিয়ার নাম না থাকলে এটি ব্যবহার হবে।"

msgid "Use RedX's test server"
msgstr "RedX-এর টেস্ট সার্ভার ব্যবহার করুন"

msgid "Only for trying things out: parcels are not real."
msgstr "শুধু পরীক্ষার জন্য: পার্সেল আসল নয়।"

msgid "Test RedX"
msgstr "RedX পরীক্ষা"

msgid "Save first, then test. It checks the token and lists your pickup stores: nothing is booked."
msgstr "আগে সেভ করুন, তারপর পরীক্ষা করুন। এটি টোকেন যাচাই করে পিকআপ স্টোরের তালিকা দেখায়: কিছু বুক হয় না।"

msgid "Lighter pages"
msgstr "হালকা পেজ"

msgid "After turning a switch on, open your home page, a product, the cart and the checkout once to check, and clear the cache if you use a cache plugin."
msgstr "কোনো সুইচ চালু করার পর একবার হোম পেজ, একটি প্রোডাক্ট, কার্ট ও চেকআউট খুলে দেখুন, আর ক্যাশ প্লাগইন থাকলে ক্যাশ মুছে দিন।"

msgid "Remove the emoji script"
msgstr "ইমোজি স্ক্রিপ্ট সরান"

msgid "WordPress adds a script to every page for emoji on very old browsers. Phones and new browsers show emoji without it."
msgstr "খুব পুরোনো ব্রাউজারে ইমোজি দেখাতে WordPress প্রতিটি পেজে একটি স্ক্রিপ্ট যোগ করে। ফোন ও নতুন ব্রাউজার এটা ছাড়াই ইমোজি দেখায়।"

msgid "Remove the embed script"
msgstr "এমবেড স্ক্রিপ্ট সরান"

msgid "Only needed to show your posts as cards inside other WordPress sites."
msgstr "শুধু অন্য WordPress সাইটে আপনার পোস্ট কার্ড আকারে দেখাতে লাগে।"

msgid "WooCommerce files only on shop pages"
msgstr "WooCommerce ফাইল শুধু শপের পেজে"

msgid "Blog posts and plain pages load without WooCommerce's styles and scripts. Shop, product, cart, checkout, account, the home page and pages with product widgets keep them."
msgstr "ব্লগ পোস্ট ও সাধারণ পেজ WooCommerce-এর স্টাইল ও স্ক্রিপ্ট ছাড়া লোড হবে। শপ, প্রোডাক্ট, কার্ট, চেকআউট, অ্যাকাউন্ট, হোম পেজ আর প্রোডাক্ট উইজেট থাকা পেজে এগুলো থাকবে।"

msgid "Calmer \"Heartbeat\""
msgstr "শান্ত \"Heartbeat\""

msgid "An open admin tab asks the server every 15–60 seconds. This makes it every 2 minutes (the post editor keeps its normal speed for auto-save) and turns it off for shop visitors."
msgstr "খোলা অ্যাডমিন ট্যাব প্রতি ১৫–৬০ সেকেন্ডে সার্ভারে অনুরোধ পাঠায়। এটা চালু করলে প্রতি ২ মিনিটে পাঠাবে (অটো-সেভের জন্য পোস্ট এডিটরে আগের মতোই থাকবে) আর শপের ভিজিটরদের জন্য বন্ধ থাকবে।"

msgid "Stop bots: Cloudflare Turnstile"
msgstr "বট থামান: Cloudflare Turnstile"

msgid "A free check from Cloudflare that real people usually do not even notice. Get the two keys at dash.cloudflare.com → Turnstile → Add site (your site does not need to use Cloudflare)."
msgstr "Cloudflare-এর ফ্রি যাচাই, আসল মানুষ সাধারণত টেরও পান না। দুটি কী নিন dash.cloudflare.com → Turnstile → Add site থেকে (আপনার সাইট Cloudflare-এ না থাকলেও চলবে)।"

msgid "Use Cloudflare Turnstile"
msgstr "Cloudflare Turnstile ব্যবহার করুন"

msgid "Site key"
msgstr "সাইট কী"

msgid "Kept private: only the last 4 characters are ever shown. Leave empty to keep the saved key."
msgstr "গোপন রাখা হয়: শুধু শেষ ৪টি অক্ষর দেখানো হয়। সেভ করা কী রাখতে ফাঁকা রাখুন।"

msgid "On login and registration"
msgstr "লগইন ও রেজিস্ট্রেশনে"

msgid "wp-login.php, My Account and the login popup. If your site uses another login form (for example the Elementor \"Login\" widget), log out and test it once."
msgstr "wp-login.php, My Account আর লগইন পপআপ। সাইটে অন্য কোনো লগইন ফর্ম থাকলে (যেমন Elementor-এর \"Login\" উইজেট) লগআউট করে একবার পরীক্ষা করে নিন।"

msgid "On checkout"
msgstr "চেকআউটে"

msgid "Stops bots placing fake orders. If Cloudflare cannot be reached, the order still goes through."
msgstr "বটের ভুয়া অর্ডার আটকায়। Cloudflare-এ যোগাযোগ না হলেও অর্ডার ঠিকই হবে।"

msgid "Add to wishlist"
msgstr "উইশলিস্টে যোগ করুন"

msgid "In wishlist"
msgstr "উইশলিস্টে আছে"

msgid "%d saved products"
msgstr "%dটি সেভ করা প্রোডাক্ট"

msgid "1 saved product"
msgstr "১টি সেভ করা প্রোডাক্ট"

msgid "Saved to your wishlist"
msgstr "উইশলিস্টে সেভ হয়েছে"

msgid "Removed from your wishlist"
msgstr "উইশলিস্ট থেকে সরানো হয়েছে"

msgid "My wishlist at %s:"
msgstr "%s-এ আমার উইশলিস্ট:"

msgid "Show less"
msgstr "কম দেখান"

msgid "RedX did not accept the API token. An administrator should check it in Kenakata Kit → Courier booking."
msgstr "RedX API টোকেন গ্রহণ করেনি। অ্যাডমিনকে Kenakata Kit → Courier booking-এ টোকেনটি দেখতে হবে।"

msgid "RedX did not send its list of delivery areas. Please try again in a minute."
msgstr "RedX ডেলিভারি এরিয়ার তালিকা পাঠায়নি। এক মিনিট পরে আবার চেষ্টা করুন।"

msgid "RedX needs the delivery area (for example \"Mirpur 10\" or \"Uttara Sector 7\"). Add the area to the address, or set a default delivery area in Kenakata Kit → Courier booking."
msgstr "RedX ডেলিভারি এরিয়া চায় (যেমন \"Mirpur 10\" বা \"Uttara Sector 7\")। ঠিকানায় এরিয়া লিখুন, অথবা Kenakata Kit → Courier booking-এ একটি ডিফল্ট ডেলিভারি এরিয়া দিন।"

msgid "RedX sent an answer we could not read. Check your RedX account before sending again: the parcel may already have been created."
msgstr "RedX এমন উত্তর পাঠিয়েছে যা পড়া যায়নি। আবার পাঠানোর আগে RedX অ্যাকাউন্ট দেখে নিন: পার্সেল হয়তো আগেই তৈরি হয়ে গেছে।"

msgid "RedX did not accept this API token. Check it and save again."
msgstr "RedX এই API টোকেন গ্রহণ করেনি। যাচাই করে আবার সেভ করুন।"

msgid "Connected to RedX."
msgstr "RedX-এর সাথে সংযোগ হয়েছে।"

msgid "Pickup stores: %s"
msgstr "পিকআপ স্টোর: %s"

msgid "%d delivery areas loaded."
msgstr "%dটি ডেলিভারি এরিয়া লোড হয়েছে।"

msgid "Customers who reached the checkout and typed their phone number but did not place the order. Call them: many only needed a nudge."
msgstr "যে কাস্টমাররা চেকআউটে এসে ফোন নম্বর লিখেছেন কিন্তু অর্ডার করেননি। তাঁদের কল করুন: অনেকের শুধু একটু মনে করিয়ে দেওয়া দরকার ছিল।"

msgid "ago"
msgstr "আগে"

msgid "Brand:"
msgstr "ব্র্যান্ড:"

msgid "Cream"
msgstr "ক্রিম"

msgid "shown when the cart is empty"
msgstr "কার্ট খালি থাকলে দেখায়"

msgid "The saved key is for: %s."
msgstr "সেভ করা কী-টি এই সাইটের জন্য: %s।"

msgid "License key not working"
msgstr "লাইসেন্স কী কাজ করছে না"

msgid "License key saved. Pro is active on this site."
msgstr "লাইসেন্স কী সেভ হয়েছে। এই সাইটে Pro চালু আছে।"

msgid "The key was NOT saved."
msgstr "কী সেভ হয়নি।"

msgid "This key is for: %1$s. This website is: %2$s."
msgstr "এই কী-টি এই সাইটের জন্য: %1$s। আপনার ওয়েবসাইট: %2$s।"

msgid "Clean-up done: %d leftovers removed."
msgstr "পরিষ্কার হয়েছে: %dটি বাড়তি জিনিস মোছা হয়েছে।"

msgid "Can also send parcels with one tap (Courier booking)"
msgstr "এক ট্যাপে পার্সেলও পাঠানো যায় (Courier booking)"

msgid "One-tap booking"
msgstr "এক ট্যাপে বুকিং"

msgid "API"
msgstr "API"

msgid "Tracking link for %s"
msgstr "%s-এর ট্র্যাকিং লিংক"

msgid "No tracking page: the customer gets the tracking ID"
msgstr "ট্র্যাকিং পেজ নেই: কাস্টমার ট্র্যাকিং আইডি পাবেন"

msgid "Scheduled tasks (cron): waiting for the first run. Check again in an hour."
msgstr "নির্ধারিত কাজ (cron): প্রথমবার চলার অপেক্ষায়। এক ঘণ্টা পরে আবার দেখুন।"

msgid "When the plugin is deleted"
msgstr "প্লাগইন মুছে ফেললে"

msgid "Normally the settings and license stay in the database, so reinstalling brings everything back. Tick this only if you are removing Kenakata Kit for good. Orders and products are never deleted."
msgstr "সাধারণত সেটিংস ও লাইসেন্স ডাটাবেসে থেকে যায়, তাই আবার ইনস্টল করলে সব ফিরে আসে। শুধু Kenakata Kit একেবারে বাদ দিলে এখানে টিক দিন। অর্ডার ও প্রোডাক্ট কখনো মোছা হয় না।"

msgid "Delete all Kenakata Kit data when the plugin is deleted (settings, license key, API keys, incomplete orders)"
msgstr "প্লাগইন মুছলে Kenakata Kit-এর সব ডাটা মুছে ফেলুন (সেটিংস, লাইসেন্স কী, API কী, অসম্পূর্ণ অর্ডার)"

msgid "Questions"
msgstr "প্রশ্নোত্তর"

msgid "%s team"
msgstr "%s টিম"

msgid "Search questions"
msgstr "প্রশ্ন খুঁজুন"

msgid "Search questions…"
msgstr "প্রশ্ন খুঁজুন…"

msgid "Asked by %1$s · %2$s"
msgstr "প্রশ্ন করেছেন %1$s · %2$s"

msgid "No question matches your search."
msgstr "আপনার খোঁজার সাথে কোনো প্রশ্ন মেলেনি।"

msgid "No questions yet. Be the first to ask!"
msgstr "এখনো কোনো প্রশ্ন নেই। প্রথম প্রশ্নটি আপনিই করুন!"

msgid "Ask a question"
msgstr "প্রশ্ন করুন"

msgid "Leave this empty"
msgstr "এটি ফাঁকা রাখুন"

