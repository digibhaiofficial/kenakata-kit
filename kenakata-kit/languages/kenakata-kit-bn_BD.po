#: includes/courier-core.php:0
msgid "Plan: %1$s. Free look-ups left: %2$d."
msgstr "প্ল্যান: %1$s। ফ্রি যাচাই বাকি: %2$dটি।"

#: includes/courier-core.php:0
msgid "Choose a courier and fill in all its details first."
msgstr "আগে একটা কুরিয়ার বেছে তার সব তথ্য দিন।"

#: includes/courier-core.php:0
msgid "By courier"
